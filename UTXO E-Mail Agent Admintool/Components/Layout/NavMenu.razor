@using Microsoft.AspNetCore.Components.Authorization

<div class="nav-brand">
    <a class="nav-brand-link" href="">
        <MudIcon Icon="@Icons.Material.Filled.Mail" Color="Color.Primary" Class="mr-2" />
        <span>UTXO E-Mail Agent</span>
    </a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <AuthorizeView>
        <Authorized>
            <MudNavMenu Class="mud-width-full">
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
                    Home
                </MudNavLink>

                <MudDivider Class="my-2" />

                <MudNavGroup Title="Clients" Icon="@Icons.Material.Filled.People" Expanded="true">
                    <MudNavLink Href="/clients/manage" Icon="@Icons.Material.Filled.List">
                        Manage Clients
                    </MudNavLink>
                    <MudNavLink Href="/clients/add" Icon="@Icons.Material.Filled.PersonAdd">
                        Add new Client
                    </MudNavLink>
                </MudNavGroup>

                <MudNavGroup Title="Agents" Icon="@Icons.Material.Filled.SmartToy" Expanded="true">
                    <MudNavLink Href="/agents/manage" Icon="@Icons.Material.Filled.List">
                        Manage Agents
                    </MudNavLink>
                </MudNavGroup>

                <MudNavGroup Title="Administrators" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="true">
                    <MudNavLink Href="/administrators/manage" Icon="@Icons.Material.Filled.List">
                        Manage Administrators
                    </MudNavLink>
                    <MudNavLink Href="/administrators/add" Icon="@Icons.Material.Filled.PersonAdd">
                        Add new Administrator
                    </MudNavLink>
                </MudNavGroup>
            </MudNavMenu>
        </Authorized>
    </AuthorizeView>
</div>
